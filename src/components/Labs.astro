---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MediaFigure from './MediaFigure.astro';

interface SectionCopy {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
}

interface Props {
  meta: SectionCopy;
  stable: CollectionEntry<'labs-stable-isotope'>;
  raman: CollectionEntry<'labs-raman'>;
}

const { meta, stable, raman } = Astro.props;

const { Content: StableContent } = await render(stable);
const { Content: RamanContent } = await render(raman);

const stableTitle = stable.data.title || 'Stable Isotope Lab';
const ramanTitle = raman.data.title || 'Raman Microscope';
---

<section
  id={meta.id || 'labs'}
  class="section reveal is-revealed"
  aria-labelledby="labs-title"
  aria-describedby="labs-lede"
>
  <p class="eyebrow">{meta.eyebrow}</p>
  <h2 id="labs-title">{meta.title}</h2>
  <p id="labs-lede" class="lede">{meta.lede}</p>

  <div id="labs-body" class="labs-stack">
    <article class="lab" id="labs-stable-isotope">
      <h3>{stableTitle}</h3>
      <div class="lab__copy prose prose--lab">
        <StableContent />
      </div>
      <div class="lab__media">
        <MediaFigure
          src="/assets/img/lab-overview-2024.jpg"
          alt="Lab overview photo showing stable isotope instrumentation"
          caption="Lab overview photo (Jan 2024)"
          width={1271}
          height={953}
          zoomable
        />
      </div>
    </article>

    <article class="lab" id="labs-raman">
      <h3>{ramanTitle}</h3>
      <div class="lab__copy prose prose--lab">
        <RamanContent />
      </div>
      <div class="lab__media">
        <MediaFigure
          src="/assets/img/raman-invia.jpg"
          alt="Renishaw InVia Raman microscope (532 nm laser setup)"
          caption="Renishaw InVia Raman microscope (532 nm)"
          width={1274}
          height={958}
          zoomable
        />
      </div>
    </article>
  </div>
</section>

<style>
  .labs-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8, 3rem);
    margin-block-start: var(--space-4);
    max-inline-size: var(--measure-wide);
    container-type: inline-size;
    container-name: labs;
  }

  /* Default: stacked. Wide container → text | image (size-aware-styling) */
  .lab {
    display: grid;
    gap: var(--space-4, 1.5rem);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    min-inline-size: 0;
  }

  .lab > h3 {
    margin-block-end: 0;
  }

  .lab__copy {
    max-inline-size: none;
  }

  .lab__media {
    min-inline-size: 0;
  }

  .lab__media :global(.media-figure) {
    margin-block: 0;
    max-inline-size: none;
    inline-size: 100%;
  }

  .lab__media :global(figcaption) {
    max-inline-size: none;
  }

  @container labs (min-width: 40rem) {
    .lab {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      column-gap: var(--space-5, 2rem);
      row-gap: var(--space-3, 1rem);
    }

    .lab > h3 {
      grid-column: 1 / -1;
    }
  }

  /* Collection MD starts with ## title — section already has h3 */
  .prose--lab :global(h2:first-child) {
    display: none;
  }

  .lab :global(.prose h3) {
    margin-block-start: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
</style>
